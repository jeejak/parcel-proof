# Local run: go run ./cmd/server  (then open http://localhost:8080)
PORT=8080
SAMPLES_DIR=samples
# Optional. Without it the demo serves the results the eval recorded.
# Use a key from a Google Cloud project with NO billing account (free
# tier), and send it staged photos only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
